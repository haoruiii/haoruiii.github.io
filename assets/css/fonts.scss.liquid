/* _sass/_fonts.scss */
/* Libertinus Serif Text Fonts */
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-Regular.woff2' | relative_url }}") format('woff2');
    font-weight: 400; /* normal */
    font-style: normal;
}{% endraw %}
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-Italic.woff2' | relative_url }}") format('woff2');
    font-weight: 400; /* normal */
    font-style: italic;
}{% endraw %}
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-Semibold.woff2' | relative_url }}") format('woff2');
    font-weight: 550; /* semibold */
    font-style: normal;
}{% endraw %}
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-SemiboldItalic.woff2' | relative_url }}") format('woff2');
    font-weight: 550; /* semibold */
    font-style: italic;
}{% endraw %}
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-Bold.woff2' | relative_url }}") format('woff2');
    font-weight: 700; /* bold */
    font-style: normal;
}{% endraw %}
{% raw %}@font-face {
    font-family: 'Libertinus Serif';
    src: url("{{ '/assets/fonts/LibertinusSerif-BoldItalic.woff2' | relative_url }}") format('woff2');
