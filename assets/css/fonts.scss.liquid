}{% endraw %}

/* Libertinus Math Font */
{% raw %}@font-face {
    font-family: 'Libertinus Math';
    src: url("{{ '/assets/fonts/LibertinusMath-Regular.woff2' | relative_url }}") format('woff2');
    font-weight: normal;
    font-style: normal;
}{% endraw %}