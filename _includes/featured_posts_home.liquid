{% assign pinned_total = include.posts | size %}

{% if page.featured_posts.limit %}
  {% assign pinned_limit = page.featured_posts.limit %}
{% else %}
  {% assign pinned_limit = pinned_total %}
{% endif %}

{% assign pinned_shown = pinned_total %}
{% if pinned_limit < pinned_shown %}
  {% assign pinned_shown = pinned_limit %}
{% endif %}

{% comment %}
  Responsive scroll_after settings:

  scroll_after:
    desktop: 2
    tablet: 2
    phone: 1

  Also supports the old format:
    scroll_after: 2
{% endcomment %}

{% assign scroll_config = page.featured_posts.scroll_after | default: 2 %}

{% if scroll_config.desktop %}
  {% assign scroll_desktop = scroll_config.desktop %}
  {% assign scroll_tablet = scroll_config.tablet | default: scroll_desktop %}
  {% assign scroll_phone = scroll_config.phone | default: scroll_tablet %}
{% else %}
  {% assign scroll_desktop = scroll_config %}
  {% assign scroll_tablet = scroll_config %}
  {% assign scroll_phone = scroll_config %}
{% endif %}

{% comment %}
  Calculate visible rows based on grid columns.

  Desktop >= 992px: 2 columns
  Tablet 768-991px: 2 columns
  Tablet 576-767px: 1 column
  Phone < 576px: 1 column
{% endcomment %}

{% assign desktop_rows = scroll_desktop | plus: 1 | divided_by: 2 | at_least: 1 %}
{% assign tablet_wide_rows = scroll_tablet | plus: 1 | divided_by: 2 | at_least: 1 %}
{% assign tablet_narrow_rows = scroll_tablet | at_least: 1 %}
{% assign phone_rows = scroll_phone | at_least: 1 %}

{% comment %}
  Calculate window heights.

  Card height: 104px
  Row gap: 12px
  Top clearance: 16px
  Bottom clearance: 20px

  Height = rows * 104
         + (rows - 1) * 12
         + 16 + 20

  Simplified:
  Height = rows * 116 + 24
{% endcomment %}

{% assign desktop_height = desktop_rows | times: 116 | plus: 24 %}
{% assign tablet_wide_height = tablet_wide_rows | times: 116 | plus: 24 %}
{% assign tablet_narrow_height = tablet_narrow_rows | times: 116 | plus: 24 %}
{% assign phone_height = phone_rows | times: 116 | plus: 24 %}

{% comment %}
  CSS controls pinned-blog scrolling independently.
  Do not add data-home-scroll here because the
  shared JS would override these calculated heights.
{% endcomment %}

<div
  class="pinned-home-scroll{% if page.featured_posts.scrollable %} pinned-home-scroll-enabled{% endif %}"
  style="
    --pinned-desktop-height: {{ desktop_height }}px;
    --pinned-tablet-wide-height: {{ tablet_wide_height }}px;
    --pinned-tablet-narrow-height: {{ tablet_narrow_height }}px;
    --pinned-phone-height: {{ phone_height }}px;
  "
>

  <div class="pinned-home-grid">

    {% for post in include.posts limit: pinned_limit %}
      <a
        class="card pinned-home-card"
        href="{{ post.url | relative_url }}"
        title="{{ post.title | escape }}"
      >

        <!-- Blog title and date on the left -->
        <div class="pinned-home-content">
          <span class="news-title pinned-home-title">
            {{ post.title }}
          </span>

          <div class="post-meta pinned-home-date">
            {% include date_format.liquid format='short' date=post.date %}
          </div>
        </div>

        <!-- Thumbnail on the right -->
        {% if post.thumbnail %}
          <span class="pinned-home-thumbnail">
            <img
              src="{{ post.thumbnail | relative_url }}"
              alt="{{ post.title | escape }}"
              loading="lazy"
            >
          </span>
        {% endif %}

      </a>
    {% endfor %}

  </div>
</div>

<style>
  /*********************************
   * Pinned blogs: outer wrapper
   *********************************/

  .pinned-home-scroll {
    box-sizing: border-box;
    max-height: none;
    overflow-x: hidden;
    overflow-y: visible;
    margin-bottom: 2rem;
  }

  .pinned-home-scroll-enabled {
    overflow-y: auto;
    overflow-x: hidden;
  }

  /*********************************
   * Pinned blogs: inner grid
   *********************************/

  .pinned-home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 104px;
    gap: 12px;

    /*
     * Internal clearance ensures that
     * card borders and shadows are visible,
     * including at the end of scrolling.
     */
    padding: 16px 14px 20px;

    margin: 0;
    box-sizing: border-box;
  }

  /*********************************
   * Individual pinned blog cards
   *********************************/

  .pinned-home-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;

    padding: 10px 12px;

    min-width: 0;
    min-height: 0;

    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .pinned-home-card:hover,
  .pinned-home-card:focus {
    color: inherit;
    text-decoration: none;
  }

  .pinned-home-card:hover .pinned-home-title,
  .pinned-home-card:focus .pinned-home-title {
    color: var(--global-theme-color);
  }

  /*********************************
   * Card text
   *********************************/

  .pinned-home-content {
    flex: 1;
    min-width: 0;
  }

  .pinned-home-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;

    font-size: 1rem;
    font-weight: normal;
    line-height: 1.4;
  }

  .pinned-home-date {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
  }

  /*********************************
   * Thumbnail
   *********************************/

  .pinned-home-thumbnail {
    flex: 0 0 96px;
    width: 96px;
  }

  .pinned-home-thumbnail img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }

  /*********************************
   * Responsive scrolling heights
   *********************************/

  /* Desktop: 2 columns */

  @media (min-width: 992px) {
    .pinned-home-scroll-enabled {
      max-height: var(--pinned-desktop-height);
    }
  }

  /* Wider tablets: 2 columns */

  @media (min-width: 768px) and (max-width: 991.98px) {
    .pinned-home-scroll-enabled {
      max-height: var(--pinned-tablet-wide-height);
    }
  }

  /* Narrower tablets: 1 column */

  @media (min-width: 576px) and (max-width: 767.98px) {
    .pinned-home-grid {
      grid-template-columns: 1fr;
    }

    .pinned-home-scroll-enabled {
      max-height: var(--pinned-tablet-narrow-height);
    }
  }

  /* Phones: 1 column */

  @media (max-width: 575.98px) {
    .pinned-home-grid {
      grid-template-columns: 1fr;
    }

    .pinned-home-scroll-enabled {
      max-height: var(--pinned-phone-height);
    }
  }
</style>
