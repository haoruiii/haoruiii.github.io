
{% assign pinned_total = include.posts | size %}

{% if page.featured_posts.limit %}
  {% assign pinned_limit = page.featured_posts.limit %}
{% else %}
  {% assign pinned_limit = pinned_total %}
{% endif %}

{% comment %}
  Responsive scroll_after configuration.

  Supports either:
    scroll_after: 2

  Or:
    scroll_after:
      desktop: 2
      tablet: 2
      phone: 1

  Actual heights are calculated by home-scroll.js.
{% endcomment %}

{% assign scroll_config = page.featured_posts.scroll_after | default: 2 %}

{% if scroll_config.desktop %}
  {% assign scroll_desktop = scroll_config.desktop %}
  {% assign scroll_tablet = scroll_config.tablet | default: scroll_desktop %}
  {% assign scroll_phone = scroll_config.phone | default: scroll_tablet %}
{% else %}
  {% assign scroll_desktop = scroll_config %}
  {% assign scroll_tablet = scroll_config %}
  {% assign scroll_phone = scroll_config %}
{% endif %}

<!-- Outer scrolling container -->
<div
  class="pinned-home-scroll home-scroll-region"
  {% if page.featured_posts.scrollable %}
    data-home-scroll
    data-home-scroll-item=".pinned-home-card"
    data-scroll-desktop="{{ scroll_desktop }}"
    data-scroll-tablet="{{ scroll_tablet }}"
    data-scroll-phone="{{ scroll_phone }}"
  {% endif %}
>

  <!-- Inner card grid -->
  <div class="pinned-home-grid">

    {% for post in include.posts limit: pinned_limit %}
      <a
        class="card pinned-home-card"
        href="{{ post.url | relative_url }}"
        title="{{ post.title | escape }}"
      >

        <!-- Blog title and date on the left -->
        <div class="pinned-home-content">
          <span class="news-title pinned-home-title">
            {{ post.title }}
          </span>

          <div class="post-meta pinned-home-date">
            {% include date_format.liquid format='short' date=post.date %}
          </div>
        </div>

        <!-- Thumbnail on the right -->
        {% if post.thumbnail %}
          <span class="pinned-home-thumbnail">
            <img
              src="{{ post.thumbnail | relative_url }}"
              alt="{{ post.title | escape }}"
              loading="lazy"
            >
          </span>
        {% endif %}

      </a>
    {% endfor %}

  </div>
</div>

<style>
  /*********************************
   * Pinned blogs: scrolling wrapper
   *********************************/

  .pinned-home-scroll {
    max-height: none;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 6px;
    margin-bottom: 2rem;
  }

  /*********************************
   * Pinned blogs: card grid
   *********************************/

  .pinned-home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 104px;
    gap: 12px;
    margin-bottom: 0;
  }

  /*********************************
   * Individual cards
   *********************************/

  .pinned-home-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    min-width: 0;
    min-height: 0;

    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .pinned-home-card:hover,
  .pinned-home-card:focus {
    color: inherit;
    text-decoration: none;
  }

  .pinned-home-card:hover .pinned-home-title,
  .pinned-home-card:focus .pinned-home-title {
    color: var(--global-theme-color);
  }

  /*********************************
   * Card text
   *********************************/

  .pinned-home-content {
    flex: 1;
    min-width: 0;
  }

  .pinned-home-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 1rem;
    font-weight: normal;
    line-height: 1.4;
  }

  .pinned-home-date {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
  }

  /*********************************
   * Thumbnail
   *********************************/

  .pinned-home-thumbnail {
    flex: 0 0 96px;
    width: 96px;
  }

  .pinned-home-thumbnail img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }

  /*********************************
   * Responsive layout
   *********************************/

  @media (max-width: 767.98px) {
    .pinned-home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
