
{% assign pinned_total = include.posts | size %}

{% if page.featured_posts.limit %}
  {% assign pinned_limit = page.featured_posts.limit %}
{% else %}
  {% assign pinned_limit = pinned_total %}
{% endif %}

{% assign pinned_shown = pinned_total %}
{% if pinned_limit < pinned_shown %}
  {% assign pinned_shown = pinned_limit %}
{% endif %}

{% assign scroll_after = page.featured_posts.scroll_after | default: 2 %}

{% assign mobile_height = scroll_after | times: 116 | minus: 12 %}
{% assign desktop_rows = scroll_after | plus: 1 | divided_by: 2 %}
{% assign desktop_height = desktop_rows | times: 116 | minus: 12 %}

{% assign enable_scroll = false %}
{% if page.featured_posts.scrollable and pinned_shown > scroll_after %}
  {% assign enable_scroll = true %}
{% endif %}

<div
  class="pinned-home-grid{% if enable_scroll %} pinned-home-scroll{% endif %}"
  style="--pinned-mobile-height: {{ mobile_height }}px; --pinned-desktop-height: {{ desktop_height }}px;"
>
  
  {% for post in include.posts limit: pinned_limit %}
    <a
      class="card pinned-home-card"
      href="{{ post.url | relative_url }}"
      title="{{ post.title | escape }}"
    >

      <!-- Blog title and date on the left -->
      <div class="pinned-home-content">
        <span class="news-title pinned-home-title">
          {{ post.title }}
        </span>

        <div class="post-meta pinned-home-date">
          {% include date_format.liquid format='short' date=post.date %}
        </div>
      </div>

      <!-- Thumbnail on the right -->
      {% if post.thumbnail %}
        <span class="pinned-home-thumbnail">
          <img
            src="{{ post.thumbnail | relative_url }}"
            alt="{{ post.title | escape }}"
            loading="lazy"
          >
        </span>
      {% endif %}

    </a>
  {% endfor %}
</div>

<style>
  .pinned-home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 104px;
    gap: 12px;
    margin-bottom: 2rem;
  }

  .pinned-home-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    min-width: 0;
    min-height: 0;

    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .pinned-home-card:hover,
  .pinned-home-card:focus {
    color: inherit;
    text-decoration: none;
  }

  .pinned-home-card:hover .pinned-home-title,
  .pinned-home-card:focus .pinned-home-title {
    color: var(--global-theme-color);
  }

  .pinned-home-content {
    flex: 1;
    min-width: 0;
  }

  .pinned-home-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 1rem;
    font-weight: normal;
    line-height: 1.4;
  }

  .pinned-home-date {
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--global-text-color-light);
  }

  .pinned-home-thumbnail {
    flex: 0 0 96px;
    width: 96px;
  }

  .pinned-home-thumbnail img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }

  .pinned-home-scroll {
    max-height: var(--pinned-desktop-height);
    overflow-y: auto;
    padding-right: 6px;
  }

  @media (max-width: 767.98px) {
    .pinned-home-grid {
      grid-template-columns: 1fr;
    }

    .pinned-home-scroll {
      max-height: var(--pinned-mobile-height);
    }
  }
</style>
